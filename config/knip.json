{
  "ignoreExportsUsedInFile": true,
  "ignoreDependencies": [
    "prettier"
  ],
  "workspaces": {
    ".": {
      "entry": [
        "src/pages/**/*.astro",
        "src/components/saibai.tsx",
        "src/styles.css",
        "scripts/terra-quality.mjs"
      ],
      "project": [
        "src/**/*.{js,mjs,cjs,jsx,ts,tsx,astro,css}"
      ],
      "astro": {
        "config": "config/astro.config.mjs"
      }
    },
    "config": {
      "entry": [
        "knip.json",
        "package.json",
        "quality.json",
        "tailwind.preset.ts",
        "tsconfig.json"
      ],
      "project": [
        "*.{js,mjs,cjs,ts}"
      ]
    }
  }
}
