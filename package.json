{
	"name": "saibai-corpus",
	"private": true,
	"packageManager": "pnpm@10.30.3",
	"scripts": {
		"prepare": "husky config/husky",
		"changeset": "pnpm exec changeset",
		"changeset:status": "pnpm exec changeset status",
		"version-packages": "pnpm exec changeset version",
		"verify": "pnpm run quality:all && pnpm run test && pnpm run build",
		"dev": "pnpm --dir config run dev",
		"build": "pnpm --dir config run build",
		"quality": "node \"$(git rev-parse --show-toplevel)/scripts/quality-runner.mjs\" quality",
		"quality:all": "node \"$(git rev-parse --show-toplevel)/scripts/quality-runner.mjs\" quality --all",
		"test": "pnpm --dir config run test"
	},
	"dependencies": {
		"@astrojs/react": "^6.0.4",
		"@dagrejs/dagre": "^1.1.4",
		"@radix-ui/react-dialog": "^1.1.15",
		"@radix-ui/react-slot": "^1.2.4",
		"@radix-ui/react-tabs": "^1.1.12",
		"@terra-symposium/standards-error-boundaries": "0.1.2",
		"@vidstack/react": "^0.4.5",
		"@xyflow/react": "^12.3.6",
		"astro": "^7.2.8",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"react": "19.2.7",
		"react-dom": "19.2.7",
		"react-simple-maps": "^3.0.0",
		"tailwind-merge": "^2.6.0",
		"topojson-client": "^3.1.0"
	},
	"devDependencies": {
		"@astrojs/check": "^0.9.4",
		"@changesets/cli": "3.0.3",
		"@eslint/js": "^9",
		"@headlessui/tailwindcss": "^0.2.2",
		"@tailwindcss/typography": "^0.5.20",
		"@terra-symposium/standards-quality": "2.3.7",
		"@types/react": "^19.2.18",
		"@types/react-dom": "^19.2.18",
		"@types/topojson-client": "^3.1.5",
		"autoprefixer": "^10.5.4",
		"eslint": "^9",
		"eslint-plugin-astro": "^1.3.1",
		"eslint-plugin-unused-imports": "^4.4.1",
		"globals": "^16.4.0",
		"husky": "9.1.7",
		"knip": "^6.33.0",
		"postcss": "^8.5.26",
		"prettier": "^3.9.6",
		"prettier-plugin-astro": "^1.1.2",
		"tailwindcss": "^3.4.19",
		"tailwindcss-animate": "^1.0.7",
		"tailwindcss-scrim-gradients": "^0.4.2",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8",
		"vidstack": "^1.15.7"
	},
	"engines": {
		"node": ">=22.19.0"
	}
}
